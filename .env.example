# OpenAI
OPENAI_API_KEY=sk-...
# Text/assistant model — uses the OpenAI Responses API
OPENAI_MODEL=gpt-5-mini
# Image generation model
OPENAI_IMAGE_MODEL=gpt-image-1

# Database
DATABASE_URL=file:./dev.db

# Staff PIN (change in production!)
STAFF_PIN=1234

# Optional: Metals API for live spot prices
METALS_API_KEY=

# Asset cleanup (hours after session close)
ASSET_CLEANUP_HOURS=24

# Email (optional for PDF emailing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=kiosk@yourshop.com

# Shop details for PDF
SHOP_NAME=Your Jewellery Shop
SHOP_ADDRESS=123 High Street, Town, Postcode
SHOP_PHONE=+44 1234 567890
SHOP_EMAIL=info@yourshop.com
